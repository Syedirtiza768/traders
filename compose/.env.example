# ============================================
# Traders — Local Development Docker Compose Environment
# DEVELOPMENT ONLY. The sample passwords below are intentionally public test
# values. Production deployments must use compose/.env.production.example and
# must replace every required password with a unique randomly generated value.
# ============================================

# --- Site Configuration ---
SITE_NAME=trader.localhost

# --- Database ---
DB_HOST=db
DB_PORT=3306
DB_ROOT_PASSWORD=trader_db_root_2026

# --- Redis ---
REDIS_CACHE=redis-cache:6379
REDIS_QUEUE=redis-queue:6379

# --- Frappe/ERPNext ---
ADMIN_PASSWORD=TraderAdmin@2026

# --- Platform Super Admin (dev seed via trader_app.setup.seed_super_admin) ---
TRADER_SUPER_ADMIN_EMAIL=
TRADER_SUPER_ADMIN_PASSWORD=

# --- Bench/Frappe/ERPNext versions (wired to backend build args) ---
BENCH_VERSION=v5.31.0
FRAPPE_VERSION=v15.113.1
ERPNEXT_VERSION=v15.114.0

# --- Ports ---
HTTP_PORT=8080

# --- Worker Configuration ---
GUNICORN_WORKERS=4
GUNICORN_THREADS=4

# --- Backup ---
BACKUP_DIR=/home/frappe/backups
BACKUP_RETENTION_DAYS=30
