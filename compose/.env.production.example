# Production Environment Template
# Copy to compose/.env and replace the empty required values with randomly
# generated secrets from a password manager or secret store before starting.
# This file contains no credentials. Do not deploy with a blank value.

SITE_NAME=trader.example.com

# Required secrets
DB_HOST=db
DB_PORT=3306
DB_ROOT_PASSWORD=
ADMIN_PASSWORD=

# Optional credentials for the explicit platform-admin seed command only.
TRADER_SUPER_ADMIN_EMAIL=
TRADER_SUPER_ADMIN_PASSWORD=

# Redis
REDIS_CACHE=redis-cache:6379
REDIS_QUEUE=redis-queue:6379

# Reproducible Frappe / ERPNext versions (keep aligned with docker-compose.yml)
BENCH_VERSION=v5.31.0
FRAPPE_VERSION=v15.113.1
ERPNEXT_VERSION=v15.114.0

# Bind the internal HTTP proxy to loopback; terminate HTTPS at the host Nginx
# configuration in infra/nginx/enxi.realtrackapp.com.conf.
HTTP_PORT=8080

# Workers (adjust based on server size)
GUNICORN_WORKERS=8
GUNICORN_THREADS=4

# Optional backup settings consumed by scripts/backup.sh
BACKUP_DIR=/srv/backups/traders
BACKUP_RETENTION_DAYS=90
